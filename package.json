{
   "name": "express-typescript",
   "version": "1.0.0",
   "license": "MIT",
   "type": "module",
   "scripts": {
      "build": "tsc",
      "typecheck": "tsc --noEmit",
      "start": "node dist/server.js",
      "predevstart": "npm run clean",
      "devstart": "npm run build && nodemon dist/server.js",
      "clean": "rimraf ./dist",
      "docker": "docker build -t ajarvis/recipe-box-api --progress=plain -f ./docker/Dockerfile ."
   },
   "dependencies": {
      "@google/genai": "^1.50.1",
      "consolidate": "^0.16.0",
      "cookie-parser": "^1.4.5",
      "cors": "^2.8.5",
      "dotenv": "^8.2.0",
      "express": "^4.17.1",
      "google-auth-library": "^8.7.0",
      "http-errors": "^1.8.0",
      "jsdom": "^16.5.3",
      "jsonwebtoken": "^9.0.3",
      "mongoose": "^7.0.2",
      "mustache": "^4.2.0",
      "node-fetch": "^2.6.1",
      "rimraf": "^3.0.2",
      "tslint": "^6.1.3",
      "uuid": "^8.3.2"
   },
   "devDependencies": {
      "@types/consolidate": "^0.14.4",
      "@types/cookie-parser": "^1.4.10",
      "@types/cors": "^2.8.19",
      "@types/dotenv-flow": "^3.3.3",
      "@types/express": "^4.17.25",
      "@types/http-errors": "^1.8.2",
      "@types/jsdom": "^16.2.15",
      "@types/jsonwebtoken": "^8.5.9",
      "@types/node": "^25.6.0",
      "@types/uuid": "^8.3.4",
      "nodemon": "^2.0.22",
      "typescript": "^6.0.3"
   }
}
